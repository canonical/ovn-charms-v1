# Clear a stale ``other_config:flow-restore-wait`` from the local Open
# vSwitch database.
#
# While ``flow-restore-wait`` is set, ``ovs-vswitchd`` neither sends nor
# receives packets to or from the datapath, so the chassis forwards traffic
# with whatever datapath flows it had prior to its last restart and nothing
# else.
#
# ovn-controller 24.03.8 leaves the option set on a chassis that is part of
# a HA chassis group, so that a subsequent unexpected reboot starts
# ``ovs-vswitchd`` in wait mode.  The option is only cleared once
# ovn-controller has connected to the Southbound database and run its flow
# installation engine.  When the Southbound database is reached over the
# very datapath that is held in wait mode this never happens, and the
# chassis stays cut off until an operator intervenes.
#
# Only act when ``external_ids:ovn-managed-flow-restore-wait`` is present.
# That is the marker ovn-controller sets to claim ownership of the option,
# and it is the same condition ovn-controller 24.03.9 and later use to clean
# up after the reverted behaviour.  A ``flow-restore-wait`` without the
# marker belongs to ``ovs-ctl restart``, which clears it itself once it has
# restored the saved flows, and must be left alone.

set -u

# ``ovs-vswitchd`` does not update ``cur_cfg`` while it waits for flow
# restore, so any ovs-vsctl invocation that waits for it to catch up would
# block for the full timeout.
OVS_VSCTL="ovs-vsctl --no-wait --timeout=5"

# Exit successfully on anything unexpected.  This script runs before
# ovn-controller starts and must never be the reason it does not.
if ! $OVS_VSCTL list Open_vSwitch >/dev/null 2>&1; then
    echo "Open vSwitch database not available, nothing to do."
    exit 0
fi

managed=$($OVS_VSCTL --if-exists get Open_vSwitch . \
    external_ids:ovn-managed-flow-restore-wait 2>/dev/null)
if [ -z "$managed" ]; then
    exit 0
fi

value=$($OVS_VSCTL --if-exists get Open_vSwitch . \
    other_config:flow-restore-wait 2>/dev/null)
if [ -z "$value" ]; then
    exit 0
fi

echo "Clearing OVN managed flow-restore-wait=$value."
if ! $OVS_VSCTL \
        -- remove Open_vSwitch . other_config flow-restore-wait \
        -- remove Open_vSwitch . external_ids \
            ovn-managed-flow-restore-wait; then
    echo "Failed to clear OVN managed flow-restore-wait." >&2
fi

exit 0
